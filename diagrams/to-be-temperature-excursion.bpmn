<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_Excursion" targetNamespace="https://github.com/konstantyn-d/pharmatrack-business-analysis">
  <bpmn:collaboration id="Collab_Process_Excursion">
    <bpmn:participant id="Pool_Process_Excursion" name="TO-BE · Temperature excursion in transit" processRef="Process_Excursion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Excursion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sys" name="PharmaTrack">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Band</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Size</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Crit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Recalc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ops" name="Operations manager">
        <bpmn:flowNodeRef>T_AssignA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Act</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="Compliance officer">
        <bpmn:flowNodeRef>T_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Reading received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Band" name="Outside temperature band?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Store" name="Store reading">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Ok" name="In range">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Size" name="More than 2 °C outside?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Crit" name="Raise CRITICAL alert">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Warn" name="Raise WARNING alert">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Recalc" name="Recalculate risk &amp; log deviation">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_AssignA" name="Assign alert to owner">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Act" name="Contact carrier, re-ice or re-route">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Report" name="Generate deviation report">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Resolve" name="Resolve alert with comment">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Excursion closed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="G_Band" />
    <bpmn:sequenceFlow id="Flow_2" name="No" sourceRef="G_Band" targetRef="T_Store" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Store" targetRef="End_Ok" />
    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="G_Band" targetRef="G_Size" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="G_Size" targetRef="T_Crit" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="G_Size" targetRef="T_Warn" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_Crit" targetRef="T_Recalc" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_Warn" targetRef="T_Recalc" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_Recalc" targetRef="T_AssignA" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_AssignA" targetRef="T_Act" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_Act" targetRef="T_Report" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T_Report" targetRef="T_Resolve" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T_Resolve" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Excursion">
    <bpmndi:BPMNPlane id="Plane_Process_Excursion" bpmnElement="Collab_Process_Excursion">
      <bpmndi:BPMNShape id="Pool_Process_Excursion_di" bpmnElement="Pool_Process_Excursion" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="1770" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sys_di" bpmnElement="Lane_Sys" isHorizontal="true">
        <dc:Bounds x="90" y="20" width="1740" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ops_di" bpmnElement="Lane_Ops" isHorizontal="true">
        <dc:Bounds x="90" y="340" width="1740" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comp_di" bpmnElement="Lane_Comp" isHorizontal="true">
        <dc:Bounds x="90" y="490" width="1740" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="172" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="104" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Band_di" bpmnElement="G_Band" isMarkerVisible="true">
        <dc:Bounds x="335" y="55" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="231" y="97" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Store_di" bpmnElement="T_Store">
        <dc:Bounds x="470" y="40" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ok_di" bpmnElement="End_Ok">
        <dc:Bounds x="682" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="104" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Size_di" bpmnElement="G_Size" isMarkerVisible="true">
        <dc:Bounds x="505" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="271" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Crit_di" bpmnElement="T_Crit">
        <dc:Bounds x="640" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Warn_di" bpmnElement="T_Warn">
        <dc:Bounds x="640" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Recalc_di" bpmnElement="T_Recalc">
        <dc:Bounds x="810" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_AssignA_di" bpmnElement="T_AssignA">
        <dc:Bounds x="980" y="375" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Act_di" bpmnElement="T_Act">
        <dc:Bounds x="1150" y="375" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Report_di" bpmnElement="T_Report">
        <dc:Bounds x="1320" y="525" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Resolve_di" bpmnElement="T_Resolve">
        <dc:Bounds x="1490" y="525" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1702" y="547" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1670" y="589" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="80" />
        <di:waypoint x="335" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="385" y="80" />
        <di:waypoint x="470" y="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="393" y="62" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="80" />
        <di:waypoint x="682" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="360" y="105" />
        <di:waypoint x="360" y="240" />
        <di:waypoint x="505" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="366" y="166" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="555" y="240" />
        <di:waypoint x="598" y="240" />
        <di:waypoint x="598" y="190" />
        <di:waypoint x="640" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="208" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="555" y="240" />
        <di:waypoint x="598" y="240" />
        <di:waypoint x="598" y="290" />
        <di:waypoint x="640" y="290" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="258" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="760" y="190" />
        <di:waypoint x="785" y="190" />
        <di:waypoint x="785" y="240" />
        <di:waypoint x="810" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="760" y="290" />
        <di:waypoint x="785" y="290" />
        <di:waypoint x="785" y="240" />
        <di:waypoint x="810" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="930" y="240" />
        <di:waypoint x="955" y="240" />
        <di:waypoint x="955" y="415" />
        <di:waypoint x="980" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1100" y="415" />
        <di:waypoint x="1150" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1270" y="415" />
        <di:waypoint x="1295" y="415" />
        <di:waypoint x="1295" y="565" />
        <di:waypoint x="1320" y="565" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1440" y="565" />
        <di:waypoint x="1490" y="565" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1610" y="565" />
        <di:waypoint x="1702" y="565" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
