<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_LaneAssessment" targetNamespace="https://github.com/konstantyn-d/pharmatrack-business-analysis">
  <bpmn:collaboration id="Collab_Process_LaneAssessment">
    <bpmn:participant id="Pool_Process_LaneAssessment" name="TO-BE · Lane creation &amp; risk assessment" processRef="Process_LaneAssessment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_LaneAssessment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Ops" name="Operations manager">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="PharmaTrack">
        <bpmn:flowNodeRef>T_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="Compliance officer">
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Val" name="Validator">
        <bpmn:flowNodeRef>T_Verify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="New lane needed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Req" name="Define cargo, temperature band &amp; handling">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Route" name="Build route: nodes &amp; legs">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Assign" name="Assign company to every node &amp; leg">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Resolve" name="Resolve certificates &amp; capabilities">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Rules" name="Run risk rules (8 categories)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Score" name="Score lane &amp; write audit event">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Risk" name="Critical or high findings?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Lane ready for shipments">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_Review" name="Review findings &amp; recommended actions">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Fix" name="How to fix?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Verify" name="Verify or reject certificate">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="T_Req" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_Req" targetRef="T_Route" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Route" targetRef="T_Assign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_Assign" targetRef="T_Resolve" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T_Resolve" targetRef="T_Rules" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T_Rules" targetRef="T_Score" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_Score" targetRef="G_Risk" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="G_Risk" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="G_Risk" targetRef="T_Review" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_Review" targetRef="G_Fix" />
    <bpmn:sequenceFlow id="Flow_11" name="Change partner" sourceRef="G_Fix" targetRef="T_Assign" />
    <bpmn:sequenceFlow id="Flow_12" name="Verify evidence" sourceRef="G_Fix" targetRef="T_Verify" />
    <bpmn:sequenceFlow id="Flow_13" name="Re-assess" sourceRef="T_Verify" targetRef="T_Resolve" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_LaneAssessment">
    <bpmndi:BPMNPlane id="Plane_Process_LaneAssessment" bpmnElement="Collab_Process_LaneAssessment">
      <bpmndi:BPMNShape id="Pool_Process_LaneAssessment_di" bpmnElement="Pool_Process_LaneAssessment" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="1940" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ops_di" bpmnElement="Lane_Ops" isHorizontal="true">
        <dc:Bounds x="90" y="20" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sys_di" bpmnElement="Lane_Sys" isHorizontal="true">
        <dc:Bounds x="90" y="170" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comp_di" bpmnElement="Lane_Comp" isHorizontal="true">
        <dc:Bounds x="90" y="320" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Val_di" bpmnElement="Lane_Val" isHorizontal="true">
        <dc:Bounds x="90" y="470" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="172" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="119" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Req_di" bpmnElement="T_Req">
        <dc:Bounds x="300" y="55" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Route_di" bpmnElement="T_Route">
        <dc:Bounds x="470" y="55" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Assign_di" bpmnElement="T_Assign">
        <dc:Bounds x="640" y="55" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Resolve_di" bpmnElement="T_Resolve">
        <dc:Bounds x="810" y="205" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Rules_di" bpmnElement="T_Rules">
        <dc:Bounds x="980" y="205" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Score_di" bpmnElement="T_Score">
        <dc:Bounds x="1150" y="205" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Risk_di" bpmnElement="G_Risk" isMarkerVisible="true">
        <dc:Bounds x="1355" y="220" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1251" y="262" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1872" y="227" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1840" y="269" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Review_di" bpmnElement="T_Review">
        <dc:Bounds x="1490" y="355" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Fix_di" bpmnElement="G_Fix" isMarkerVisible="true">
        <dc:Bounds x="1695" y="370" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1670" y="426" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Verify_di" bpmnElement="T_Verify">
        <dc:Bounds x="1830" y="505" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="95" />
        <di:waypoint x="300" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="95" />
        <di:waypoint x="470" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="95" />
        <di:waypoint x="640" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="760" y="95" />
        <di:waypoint x="785" y="95" />
        <di:waypoint x="785" y="245" />
        <di:waypoint x="810" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="930" y="245" />
        <di:waypoint x="980" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1100" y="245" />
        <di:waypoint x="1150" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1270" y="245" />
        <di:waypoint x="1355" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1405" y="245" />
        <di:waypoint x="1872" y="245" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1413" y="227" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1380" y="270" />
        <di:waypoint x="1380" y="395" />
        <di:waypoint x="1490" y="395" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1386" y="326" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1610" y="395" />
        <di:waypoint x="1695" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1720" y="370" />
        <di:waypoint x="1720" y="34" />
        <di:waypoint x="700" y="34" />
        <di:waypoint x="700" y="55" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1630" y="37" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1745" y="395" />
        <di:waypoint x="1788" y="395" />
        <di:waypoint x="1788" y="545" />
        <di:waypoint x="1830" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1794" y="463" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1890" y="585" />
        <di:waypoint x="1890" y="608" />
        <di:waypoint x="870" y="608" />
        <di:waypoint x="870" y="285" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="878" y="590" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
