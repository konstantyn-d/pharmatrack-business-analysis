<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_AsIs" targetNamespace="https://github.com/konstantyn-d/pharmatrack-business-analysis">
  <bpmn:collaboration id="Collab_Process_AsIs">
    <bpmn:participant id="Pool_Process_AsIs" name="AS-IS · Manual lane assessment (before PharmaTrack)" processRef="Process_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Pharma customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ops" name="4Viso operations">
        <bpmn:flowNodeRef>T_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_All</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Partner" name="Logistics partners">
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="4Viso compliance">
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Sheet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="New lane needed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Request" name="Request lane by e-mail">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Identify" name="Identify partners for each step">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Email" name="E-mail partners for certificates">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Send" name="Send certificates (PDF)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_All" name="All documents received?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Check" name="Check certificates one by one">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Sheet" name="Score risk in spreadsheet">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Ok" name="Risk acceptable?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Approve" name="Send approval by e-mail">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Lane approved">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="T_Request" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_Request" targetRef="T_Identify" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Identify" targetRef="T_Email" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_Email" targetRef="T_Send" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T_Send" targetRef="G_All" />
    <bpmn:sequenceFlow id="Flow_6" name="No, chase" sourceRef="G_All" targetRef="T_Email" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="G_All" targetRef="T_Check" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_Check" targetRef="T_Sheet" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_Sheet" targetRef="G_Ok" />
    <bpmn:sequenceFlow id="Flow_10" name="No, re-select" sourceRef="G_Ok" targetRef="T_Identify" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="G_Ok" targetRef="T_Approve" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T_Approve" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_AsIs">
    <bpmndi:BPMNPlane id="Plane_Process_AsIs" bpmnElement="Collab_Process_AsIs">
      <bpmndi:BPMNShape id="Pool_Process_AsIs_di" bpmnElement="Pool_Process_AsIs" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="1940" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="90" y="20" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ops_di" bpmnElement="Lane_Ops" isHorizontal="true">
        <dc:Bounds x="90" y="170" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Partner_di" bpmnElement="Lane_Partner" isHorizontal="true">
        <dc:Bounds x="90" y="320" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comp_di" bpmnElement="Lane_Comp" isHorizontal="true">
        <dc:Bounds x="90" y="470" width="1910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="172" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="119" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Request_di" bpmnElement="T_Request">
        <dc:Bounds x="300" y="55" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Identify_di" bpmnElement="T_Identify">
        <dc:Bounds x="470" y="205" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Email_di" bpmnElement="T_Email">
        <dc:Bounds x="640" y="205" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Send_di" bpmnElement="T_Send">
        <dc:Bounds x="810" y="355" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_All_di" bpmnElement="G_All" isMarkerVisible="true">
        <dc:Bounds x="1015" y="220" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="990" y="276" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Check_di" bpmnElement="T_Check">
        <dc:Bounds x="1150" y="505" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Sheet_di" bpmnElement="T_Sheet">
        <dc:Bounds x="1320" y="505" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Ok_di" bpmnElement="G_Ok" isMarkerVisible="true">
        <dc:Bounds x="1525" y="520" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1500" y="576" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Approve_di" bpmnElement="T_Approve">
        <dc:Bounds x="1660" y="505" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1872" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1840" y="119" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="95" />
        <di:waypoint x="300" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="95" />
        <di:waypoint x="445" y="95" />
        <di:waypoint x="445" y="245" />
        <di:waypoint x="470" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="245" />
        <di:waypoint x="640" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="760" y="245" />
        <di:waypoint x="785" y="245" />
        <di:waypoint x="785" y="395" />
        <di:waypoint x="810" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="930" y="395" />
        <di:waypoint x="972" y="395" />
        <di:waypoint x="972" y="245" />
        <di:waypoint x="1015" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1040" y="220" />
        <di:waypoint x="1040" y="184" />
        <di:waypoint x="700" y="184" />
        <di:waypoint x="700" y="205" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="187" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1065" y="245" />
        <di:waypoint x="1108" y="245" />
        <di:waypoint x="1108" y="545" />
        <di:waypoint x="1150" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1114" y="388" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1270" y="545" />
        <di:waypoint x="1320" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1440" y="545" />
        <di:waypoint x="1525" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1550" y="520" />
        <di:waypoint x="1550" y="148" />
        <di:waypoint x="530" y="148" />
        <di:waypoint x="530" y="205" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1460" y="151" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1575" y="545" />
        <di:waypoint x="1660" y="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1583" y="527" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1780" y="545" />
        <di:waypoint x="1826" y="545" />
        <di:waypoint x="1826" y="95" />
        <di:waypoint x="1872" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
